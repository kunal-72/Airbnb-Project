<% layout("/layouts/boilerPlate") -%>

    <div class="row mt-3 mb-2">
        <div class="col-8 offset-2">

            <h3>Edit your Listing</h3>
            <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input type="text" value="<%= listing.title %>" class="form-control" placeholder="enter title"
                        name="listing[title]" required>
                    
                    <div class="invalid-feedback">title required</div>    
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" id="" rows="3" cols="35"
                        class="form-control" required>  <%= listing.description %> </textarea>
                        <div class="invalid-feedback">decsription required</div>
                </div>
                
                Original listing Image
                <div class="mb-3">
                    <img src="<%= originalImageUrl %>" alt="" srcset="">
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image New Image</label>
                    <input type="file" name="listing[image]" class="form-control">
                    <div class="invalid-feedback">url required</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input  name="listing[price]" class="form-control" value="<%= listing.price %>" required>
                        <div class="invalid-feedback">enter price</div>
                    </div>
                    
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input type="text" class="form-control" value="<%= listing.country %>" name="listing[country]" required>
                        <div class="invalid-feedback">required country name</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" class="form-control" value="<%= listing.location %>" name="listing[location]" required>
                    <div class="invalid-feedback">required location</div>
                </div>

                <button class="btn btn-dark add-btn">Save</button>
            </form>
        </div>
    </div>